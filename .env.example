# Copy this file to .env in the project root and adjust as needed.
# All values shown are the defaults used if .env is missing.

# Where the SQLite database file lives
DATABASE_URL=./database/app.db

# Where uploaded/downloaded images are stored
STORAGE_PATH=./storage

# Face recognition tuning (can also be changed in the Settings page)
FACE_RECOGNITION_THRESHOLD=0.45
FACE_DETECTION_THRESHOLD=0.5

# Demo admin account created on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT signing secret — change this for anything beyond local dev
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRE_MINUTES=480

# Max upload size in MB
MAX_UPLOAD_MB=20

# Google Drive OAuth client — used for (a) downloading PRIVATE single Drive
# files by URL, and (b) the Event Photo Processing WRITE path (the admin's
# one-time "Connect Google Drive" login, used to create the output folder
# tree and upload photos — a service account has no Drive storage quota to
# upload with, so uploads must run as a real Google account).
#
# Uses the drive.file scope, which is NOT a restricted scope: the app can be
# published to Production without Google's paid annual security assessment,
# so any admin can connect. In exchange the app can only touch files it
# created itself, which is why processed output lands in a new folder in the
# connected admin's own Drive rather than inside the photographer's folder.
#
# Create a Google Cloud OAuth client (type: Web application) with authorized
# redirect URI http://localhost:8000/api/photo-batches/drive-oauth/callback,
# then put its values here.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Event Photo Processing — service account for READING a photographer's
# shared Drive FOLDER (listing/downloading their photos). Create a Google
# Cloud service account, download its JSON key, put the file path here, then
# have the photographer share their Drive folder with that key's
# client_email (shown on the Event Photos page once this is set) — Viewer
# access is enough, this account only ever reads.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# How often (seconds) the background job checks for expired photo batches
# and deletes them per their retention setting.
RETENTION_CHECK_INTERVAL_SECONDS=300

# Application updates from GitHub (PUBLIC repository).
#
# This is the ONLY setting normally required. "owner/repo" of the public
# repository this installation updates from. Both the release check and the
# git fetch run anonymously — no access token, credential helper, or git
# configuration is needed on any machine.
GITHUB_REPO=

# Only a PUBLISHED GitHub Release is offered as an update. Pushing a commit or
# a bare tag is development and will not prompt anyone to update.
#
# The 'origin' remote must be the HTTPS GitHub URL, not SSH, and must point at
# the same repository as GITHUB_REPO. The updater checks this and reports a
# clear error rather than rewriting your remote for you.

# OPTIONAL, and normally left empty. Unauthenticated GitHub API access allows
# 60 requests per hour per IP, which is far more than an hourly update check
# needs — set this only if many machines share one outbound IP and you hit
# that limit. It is used solely as an API rate-limit header; git never uses
# it, and updates work fully without it. Never logged or returned by any API.
GITHUB_TOKEN=

# How often (minutes) the app checks GitHub for a newer release. Detection
# only — nothing is ever installed without an admin clicking Update Now.
UPDATE_CHECK_INTERVAL_MINUTES=60
